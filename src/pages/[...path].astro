---
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ModuleContents from '../components/ModuleContents.astro';
import TopicOverview from '../components/TopicOverview.astro';
import LearningTrail from '../components/LearningTrail.astro';
import type {CollectionEntry} from 'astro:content';
import type {Topic} from '../lib/schema';
import RelatedContent from '../components/RelatedContent.astro';
import SourceList from '../components/learning/SourceList.astro';
import { visible, modulePath, chapterPath, topicPath } from '../lib/content';

interface Props {entry:CollectionEntry<'modules'|'chapters'|'foundations'|'theory'>;kind:string;topic?:Topic}

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  const chapters = await getCollection('chapters');
  const foundations = await getCollection('foundations');
  const theory = await getCollection('theory');
  return [
    ...modules.filter(e=>visible(e.data.status)).map(entry=>({params:{path:modulePath(entry.data).replace(/\/$/,'')},props:{entry,kind:'module'}})),
    ...modules.filter(e=>visible(e.data.status)).flatMap(entry=>entry.data.topics.filter(t=>visible(t.status)).map(topic=>({params:{path:topicPath(entry.data,topic).replace(/\/$/,'')},props:{entry,kind:'topic',topic}}))),
    ...chapters.filter(e=>visible(e.data.status) && modules.some(m=>m.data.id===e.data.module && visible(m.data.status))).map(entry=>({params:{path:chapterPath(entry.data,modules.map(m=>m.data)).replace(/\/$/,'')},props:{entry,kind:'chapter'}})),
    ...foundations.filter(e=>visible(e.data.status)).map(entry=>({params:{path:`foundations/${entry.data.slug}`},props:{entry,kind:'foundation'}})),
    ...theory.filter(e=>visible(e.data.status)).map(entry=>({params:{path:`theory/${entry.data.slug}`},props:{entry,kind:'theory'}})),
  ];
}
const { entry,kind,topic }=Astro.props;
const { Content,headings }=await render(entry);
const summary='summary' in entry.data ? entry.data.summary : '';
---
<StarlightPage frontmatter={{title:topic?.title??entry.data.title,description:topic?.summary??summary,editUrl:`https://github.com/spicmaff/bioinformatics-atlas/edit/main/${entry.filePath}`,tableOfContents:['module','topic'].includes(kind)?false:{minHeadingLevel:2,maxHeadingLevel:2}}} headings={['module','topic'].includes(kind)?[]:headings} hasSidebar={!['module','topic'].includes(kind)}>
  {entry.data.status!=='published' && <aside class="draft-banner" data-pagefind-ignore>Черновик · виден только в локальном просмотре с INCLUDE_DRAFTS=1.</aside>}
  {kind==='module' && entry.collection==='modules' && <ModuleContents module={entry.data}/>}
  {kind==='topic' && entry.collection==='modules' && topic && <TopicOverview module={entry.data} topic={topic}/>}
  {kind==='chapter'&&entry.collection==='chapters'&&<LearningTrail chapter={entry.data}/>}
  {!['module','topic'].includes(kind)&&<><div class:list={['sl-markdown-content',kind==='chapter' && 'chapter-body']}><Content/></div><h2 id="sources">Источники</h2><SourceList sources={entry.data.sources}/><RelatedContent id={entry.data.id}/></>}
  {kind==='chapter'&&entry.collection==='chapters'&&<LearningTrail chapter={entry.data} footer/>}
</StarlightPage>
