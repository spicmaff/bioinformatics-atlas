---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ModuleNavigator from '../components/ModuleNavigator';
import {readModules,readChapters,readDecisions,resolveRef,moduleOrder} from '../lib/content';
import {withBase} from '../lib/url';
const decisions=readDecisions(),chapters=readChapters();
const modules=readModules().map(m=>m.data).filter(m=>['planned','published'].includes(m.status)).sort(moduleOrder).map(m=>({...m,aliases:[...m.aliases,...decisions.filter(d=>d.target===m.id).map(d=>d.id)],href:withBase(resolveRef(m.id)),chapterCount:chapters.filter(c=>c.data.module===m.id&&c.data.status==='published').length}));
---
<StarlightPage frontmatter={{title:'Модули атласа',description:'Выберите направление, модуль, тему и алгоритм.',template:'splash',tableOfContents:false}} hasSidebar={false}>
 <ModuleNavigator client:load modules={modules}/>
</StarlightPage>
