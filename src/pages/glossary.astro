---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { withBase } from '../lib/url';
const terms=[['alignment','Выравнивание','Две строки с добавленными пропусками. Удаление пропусков восстанавливает исходные строки.'],['score','Score','Сумма оценок колонок в выбранной модели; не вероятность.'],['gap','Пропуск','Символ − сопоставляет букву одной строки с отсутствием буквы в другой.'],['state','Состояние ДП','Результат подзадачи для пары префиксов строк.'],['traceback','Traceback','Обратный проход по оптимальным предшественникам для восстановления выравнивания.'],['sequence-motif','Мотив последовательности','Паттерн букв или вероятностный профиль; будущий модуль M14.'],['network-motif','Сетевой мотив','Структура связей графа; статистическое обогащение требует заданной нулевой модели.'],['cpg-dna','CpG · метилирование ДНК','Динуклеотид цитозин–гуанин. Тема M24.'],['cpg-neural','CPG · нейронная динамика','Central pattern generator: рекуррентная система, порождающая ритм. Кейс M27.'],['homology','Гомология','Гипотеза об общем происхождении. Сходство по score само по себе её не доказывает.']];
---
<StarlightPage frontmatter={{title:'Словарь',template:'splash',tableOfContents:false}} hasSidebar={false}><p class="page-lead">Короткие определения и различения, которые легко потерять за одинаковыми обозначениями.</p><dl class="glossary">{terms.map(([id,title,definition])=><div id={id}><dt>{title}</dt><dd>{definition}</dd></div>)}</dl><p><a href={withBase('theory/dynamic-programming/')}>Общая теория динамического программирования</a></p></StarlightPage>
